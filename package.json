{
  "name": "moa-content-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "build:local": "tsc -b && vite build --config vite.offline.config.ts --mode offline && node scripts/package-local.mjs",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:local": "npm run build:local && playwright test --config playwright.local.config.ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fflate": "^0.8.3",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
